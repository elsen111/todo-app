# Application

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080



# Database - PostgreSQL

DB_URL=jdbc:postgresql://localhost:5432/todo_db
DB_USERNAME=postgres
DB_PASSWORD=your_local_database_password




# JWT Authentication

# Replace with a strong, randomly generated secret.
# Keep the same secret across application restarts.
JWT_SECRET=replace_with_a_strong_random_secret

# Access token expiration: 15 minutes
JWT_ACCESS_TOKEN_EXPIRATION=900000

# Refresh token expiration: 7 days
JWT_REFRESH_TOKEN_EXPIRATION=604800000



# Frontend & CORS

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173



# Mail (SMTP - Gmail)
# Use a Gmail "App Password", not your normal account password.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password



# Password reset with otp code
PASSWORD_RESET_OTP_SECRET=your_secret_otp_for_password_reset



# Rate Limiting

RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_DURATION=1m